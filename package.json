{
  "name": "sneakdrop-assignment",
  "version": "1.0.0",
  "description": "A small shoe brand is launching one limited sneaker. They only have 20 pairs. When the sale opens, thousands of people will click Buy at the same second.",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "vitest run",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "npx prisma migrate reset --force && npm run db:seed",
    "postinstall": "prisma generate || exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raih1107/sneakdrop-assignment.git"
  },
  "keywords": [],
  "author": "",
