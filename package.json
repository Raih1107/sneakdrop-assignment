  "bugs": {
    "url": "https://github.com/Raih1107/sneakdrop-assignment/issues"
  },
  "homepage": "https://github.com/Raih1107/sneakdrop-assignment#readme",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
